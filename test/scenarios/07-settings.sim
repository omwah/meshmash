# Settings, theme switching and backup.
key menu
key down 9
key enter
shot settings
# past Mesh node (Remote node is disabled in local mode)
key down 2
shot settings-timezone
key right 4
shot settings-timezone-eastern
key left 4
key down
key right
shot settings-clock-12h
key left
key down
key right
shot settings-theme-amber
key right 3
shot settings-theme-daylight
key left 4
key down 4
shot settings-chat-preview
key down 3
shot settings-mid
key right
shot settings-new-message
key left
key down 2
key right
shot settings-ping-bot
key left
key down 10
shot settings-end
key down 5
shot settings-telemetry
hold esc 900
key menu
key down 10
key enter
shot backup
key down
key enter
shot backup-identity-confirm
hold esc 900
ble pairing
shot ble-pairing-pin
key esc
shot ble-pairing-hidden
