# Settings, theme switching and backup.
key menu
key up 20
key down 9
key enter
shot settings
# Radio has its own heading below the identity rows (Remote node is disabled in local mode).
key down 2
shot settings-radio-row
key enter
shot radio
key right
shot radio-preset-next
key left
key esc
shot settings-after-radio
key down
shot settings-timezone
key right 4
shot settings-timezone-eastern
key left 4
key down
key right
shot settings-clock-12h
key left
key down
key right
shot settings-theme-amber
key right 3
shot settings-theme-daylight
key left 4
# CPU speed for the active UI: fast, balanced, battery saver.
key down 3
shot settings-cpu
key right
shot settings-cpu-balanced
key right
shot settings-cpu-saver
key left 2
key up 3
key down 4
shot settings-chat-preview
key down 3
shot settings-mid
key right
shot settings-new-message
key left
key down 2
key right
shot settings-ping-bot
key left
key down 8
shot settings-end
key down 5
shot settings-telemetry
hold esc 900
key menu
key up 20
key down 10
key enter
shot backup
key down
key enter
shot backup-identity-confirm
hold esc 900
ble pairing
shot ble-pairing-pin
key esc
shot ble-pairing-hidden
