# T-Deck shortcut bar: each tab selected in turn (the others show the normal
# state), for checking the Material Symbols icons. Buttons are 64 wide.
vim on
shot navbar-chats
tap 96 223
shot navbar-contacts
tap 160 223
shot navbar-nodes
tap 224 223
shot navbar-channels
tap 288 223
shot navbar-menu
# The menu remembers where it was, sub-screens included: Menu, into Diagnostics, off to
# another tab and back with the Menu button.
tap 300 225
key down 6
key enter
shot navbar-menu-diag
tap 40 225
shot navbar-menu-left
tap 300 225
shot navbar-menu-restored
# The same for the packet log, which has its own list position.
tap 300 225
key down
key enter
shot navbar-log
tap 40 225
tap 300 225
shot navbar-log-restored
