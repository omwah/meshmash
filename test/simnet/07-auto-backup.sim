# Automatic backup: a change is written to SD about 10 s later; a wipe with
# the card removed gets no restore offer and a new identity.
node Hana 7
as Hana advert
wait 15000
key menu
key down 9
key enter
shot auto-backup-status
hold esc 900
sd off
wipe
# the 2 s splash, then the restore offer
wait 2600
shot fresh-no-card
expect identity new
expect contacts 0
